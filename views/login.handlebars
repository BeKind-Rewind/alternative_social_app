<section class="auth-page">
  <h2>Log in</h2>
  <form class="login-form" novalidate>
    <div>
      <label for="email-login">Email</label>
      <input type="email" id="email-login" name="email" autocomplete="username" required />
    </div>
    <div>
      <label for="password-login">Password</label>
      <input type="password" id="password-login" name="password" autocomplete="current-password" required />
    </div>
    <div>
      <button type="submit" class="btn-primary">Log in</button>
    </div>
  </form>

  <h2>Create an account</h2>
  <p class="auth-hint">Password must be at least 8 characters.</p>
  <form class="signup-form" novalidate>
    <div>
      <label for="username-signup">Username</label>
      <input type="text" id="username-signup" name="username" autocomplete="nickname" required />
    </div>
    <div>
      <label for="email-signup">Email</label>
      <input type="email" id="email-signup" name="email" autocomplete="email" required />
    </div>
    <div>
      <label for="password-signup">Password</label>
      <input type="password" id="password-signup" name="password" autocomplete="new-password" minlength="8" required />
    </div>
    <div>
      <button type="submit" class="btn-primary">Sign up</button>
    </div>
  </form>
</section>

<script src="/javascript/login.js"></script>